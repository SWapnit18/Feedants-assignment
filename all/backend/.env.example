# ---- Server ----
NODE_ENV=development            # development | test | production
PORT=4000
HOST=0.0.0.0                    # bind all interfaces so a phone on the LAN can reach the API
# Base URL used to build absolute upload URLs (set to your LAN IP for devices, e.g. http://192.168.1.20:4000).
# If unset, derived from the request Host header.
PUBLIC_BASE_URL=
CORS_ORIGIN=*                   # '*' or comma-separated list of origins

# ---- Database ----
# Leave empty in development to auto-start an in-memory single-node replica set (auto-seeded).
# With docker compose:  mongodb://localhost:27017/feedants?replicaSet=rs0&directConnection=true
# MUST be a replica set (multi-document transactions).
MONGODB_URI=
SEED_ON_START=false             # true = wipe & seed demo data on boot (always true for the in-memory DB)

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string   # required in production (min 16 chars)
JWT_EXPIRES_IN=7d
ENABLE_DEV_LOGIN=true           # enables POST /auth/dev-login and GET /auth/users (demo only)

# ---- Payments (Razorpay) ----
PAYMENT_MODE=mock               # mock = POST /payments/mock/checkout simulates the checkout sheet; live = real Razorpay
RAZORPAY_KEY_ID=rzp_test_feedants_mock
RAZORPAY_KEY_SECRET=mock_razorpay_secret_change_me   # HMAC key for payment signature verification

# ---- Business rules ----
SEAT_HOLD_MINUTES=10            # how long a pending_payment registration holds a seat
HOLD_SWEEP_INTERVAL_MS=30000    # expired-hold sweeper interval
REFERRAL_REWARD_PAISE=1000      # ₹10 per referred signup
REFERRAL_BASE_URL=https://feedants.com/r/

# ---- Uploads ----
UPLOAD_DIR=uploads              # relative to backend/
UPLOAD_MAX_BYTES=52428800       # 50 MB

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=             # default: on (off under NODE_ENV=test)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300              # per IP per window, all /api/v1 routes
RATE_LIMIT_MUTATION_MAX=30      # per user per window for register/pay/submit/upload

# ---- Logging ----
LOG_LEVEL=info
