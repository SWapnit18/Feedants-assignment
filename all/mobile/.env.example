# Base URL of the Feedants backend (must include /api/v1).
# iOS simulator / web:     http://localhost:4000/api/v1   (default when unset)
# Android emulator:        http://10.0.2.2:4000/api/v1    (default on Android when unset)
# Physical device (Expo Go): use your computer's LAN IP, e.g. http://192.168.1.23:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
